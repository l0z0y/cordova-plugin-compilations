  "repository": {
    "type": "git",
    "url": "https://github.com/lanyangayang/cordova-mantunsci-electric.git"
  },
  "files": [
    "plugin.xml",
    "www/",
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
